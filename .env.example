# Credenciales del proyecto de Supabase (Project Settings → API).
# Copia este archivo como .env.local y reinicia `npm run dev`.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Quién saca las miniaturas de los sitios (portada de cada tarjeta de proyecto).
# Opcional: sin esto se usa Microlink, que no pide credenciales pero limita las
# capturas por día. Los huecos {url}, {w} y {h} los rellena /api/thumb. Ponlo en
# "off" para no enseñar miniaturas y que ninguna dirección revisada salga de la
# instalación; sin foto, la tarjeta se queda en su color, que es como estaba.
# THUMBNAIL_ENDPOINT=off

# Quién dibuja los avatares del equipo. Opcional: sin esto se usa DiceBear, que
# no pide credenciales. Los huecos {style}, {seed} y {bg} los rellena
# /api/avatar. Ponlo en "off" para que de esta instalación no salga ni una
# petición: cada quien se queda con su disco de color y su inicial, que ya
# distinguen a un equipo entero.
# AVATAR_ENDPOINT=off
